$bog_id_app $mol_scroll
	title @ \Гипер ID
	plugins /
		<= Theme $bog_theme_auto
			theme_light \$mol_theme_calm_light
			theme_dark \$mol_theme_calm_dark
	sub /
		<= Column $mol_view
			sub <= panels /
				<= Login $mol_list
					rows <= login_rows /
						<= Brand $mol_view
							sub /
								<= Brand_icon $mol_icon_fingerprint
								<= title
						<= Head $mol_paragraph
							title <= head \
						<= Accounts $mol_list
							rows <= account_rows /
								<= Account* $bog_id_row
									current <= account_current* false
									name <= account_name* \
									note <= account_note* \
									click? <=> account_open*? null
									face /
										<= Account_face* $mol_avatar
											id <= account_id* \
									tail <= account_tail* /
										<= Account_check* $mol_icon_check
						<= Add $bog_id_row
							name @ \Добавить аккаунт
							click? <=> add_open? null
							face /
								<= Add_icon $mol_icon_plus
						<= Enter $bog_id_row
							name @ \Войти по биометрии
							note @ \Отпечаток, лицо или ключ доступа
							click? <=> passkey_enter? null
							face /
								<= Enter_icon $mol_icon_fingerprint
						<= Make $bog_id_row
							name @ \Создать новый аккаунт
							note @ \С отдельным ключом и приложениями
							click? <=> account_make? null
							face /
								<= Make_icon $mol_icon_account_plus
						<= Back $mol_button_minor
							title @ \Назад
							click? <=> add_close? null
						<= Enter_status $mol_paragraph
							title <= enter_status \
						<= Draft $mol_string
							hint @ \Как вас зовут
							value? <=> name_draft? \
						<= Consent_text $mol_paragraph
							title <= consent_text \
						<= Consent_self $mol_paragraph
							title @ \Это ваш собственный ключ: войдите из приложения с отдельным ключом
						<= Consent_wait $mol_paragraph
							title @ \Ждём данные аккаунта из Гипер Базы…
						<= Approve $mol_button_major
							title <= approve_title \
							enabled <= approve_enabled true
							click? <=> approve? null
						<= Reject $mol_button_minor
							title @ \Отмена
							click? <=> reject? null
				<= Profile $mol_list
					rows <= profile_rows /
						<= Profile_head $mol_paragraph
							title @ \Профиль
						<= Name $mol_string
							hint @ \Как вас показывать приложениям
							value? <=> name? \
						<= Bind $bog_id_row
							name <= passkey_bind_title @ \Включить вход по биометрии
							note <= bind_note \
							click? <=> passkey_bind? null
							face /
								<= Bind_icon $mol_icon_fingerprint
						<= Bind_status $mol_paragraph
							title <= bind_status \
						<= Exit $bog_id_row
							name @ \Выйти на этом устройстве
							note @ \Вернуться можно по биометрии
							click? <=> account_exit? null
							face /
								<= Exit_icon $mol_icon_logout
				<= Grants_panel $mol_list
					rows /
						<= Grants_head $mol_paragraph
							title @ \Подключённые приложения
						<= Grants $mol_list
							rows <= grant_rows /
								<= Grant* $mol_list
									rows <= grant_parts* /
										<= Grant_head* $mol_view
											sub /
												<= Grant_title* $mol_paragraph
													title <= grant_title* \
												<= Grant_revoke* $mol_button_minor
													title @ \Отозвать всё
													enabled <= grant_active* true
													click? <=> grant_revoke*? null
										<= App* $mol_view
											sub /
												<= App_title* $mol_paragraph
													title <= app_title* \
												<= App_revoke* $mol_button_minor
													title @ \Отозвать
													click? <=> app_revoke*? null
	head_pick @ \Выберите аккаунт для входа в {app}
	head_own @ \Ваши аккаунты
	head_add @ \Добавление аккаунта
	account_locked @ \Нужен вход по биометрии
	account_noname @ \Без имени
	approve_as @ \Войти как {name}
	approve_plain @ \Войти
	consent_template @ \Приложение получит доступ к разделу «{scope}» и увидит ваше имя. Ключ аккаунта остаётся у вас
	grant_template @ \{app} · {scope}
	device_template @ \Устройство {lord}
	passkey_rebind_title @ \Привязать ещё одну биометрию
	passkey_done @ \Вход по биометрии включён
	passkey_none @ \Без неё аккаунт живёт только в этом браузере
	passkey_wait @ \Ждём зашифрованный ключ из Базы…
	passkey_offline @ \Нет связи с Гипер Базой. Вход продолжится сам, когда она появится
	passkey_unsaved @ \Нет связи с Гипер Базой: пока войти можно только на этом устройстве
	passkey_wrong @ \Этот ключ доступа не открывает аккаунт
	passkey_foreign @ \Это ключ доступа другого приложения. Выберите другой
	passkey_cancel @ \Вход отменён или на устройстве нет подходящего ключа
	passkey_noprf @ \Хранилище ключа не отдало секрет PRF. Создайте ключ заново и выберите в окне браузера другое место: Связку ключей iCloud или Google Менеджер паролей. Профиль Chrome и Bitwarden PRF не дают
	passkey_again @ \Ключ создан. Нажмите ещё раз, чтобы подтвердить
